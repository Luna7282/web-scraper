# Copy this file to .env and fill in real values. .env is gitignored.

# Only needed if you select the OpenAI provider.
OPENAI_API_KEY=

# Only needed if you select the NVIDIA NIM provider.
# Get one at https://build.nvidia.com/ (free tier).
NVIDIA_API_KEY=

# Ollama (local): no key needed, config.py hardcodes localhost:11434.

# Only needed if you select the Ollama cloud provider. This is Ollama's own
# documented variable name (docs.ollama.com/api/authentication) -- keep it
# as OLLAMA_API_KEY, not a project-invented name, so it matches `ollama
# signin` / the Ollama CLI's own conventions if you ever use both.
# Get one at https://ollama.com/settings/keys.
# Chat/extraction only -- Ollama cloud has no embedding models (see
# LESSONS_LEARNED.md #7). Embeddings always come from local Ollama
# regardless of which provider this key is for.
OLLAMA_API_KEY=
