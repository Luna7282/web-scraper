# Copy this file to .env and fill in real values. .env is gitignored.

# -----------------------------------------------------------------------
# Traditional-path LLM providers (chat/extraction). Pick one per run --
# see main.py's interactive provider prompt or a headless config's
# "provider"/"model" fields. Embeddings always come from local Ollama
# regardless of which of these is selected (see the "Provider routing"
# invariant in CLAUDE.md) -- these keys never affect embeddings.
# -----------------------------------------------------------------------

# Only needed if you select the OpenAI provider.
OPENAI_API_KEY=

# Only needed if you select the NVIDIA NIM provider.
# Get one at https://build.nvidia.com/ (free tier).
NVIDIA_API_KEY=

# Ollama (local): no key needed, config.py hardcodes localhost:11434.

# Only needed if you select the Ollama cloud provider. This is Ollama's own
# documented variable name (docs.ollama.com/api/authentication) -- keep it
# as OLLAMA_API_KEY, not a project-invented name, so it matches `ollama
# signin` / the Ollama CLI's own conventions if you ever use both.
# Get one at https://ollama.com/settings/keys.
# Chat/extraction only -- Ollama cloud has no embedding models (see
# LESSONS_LEARNED.md #7). Embeddings always come from local Ollama
# regardless of which provider this key is for.
OLLAMA_API_KEY=

# Only needed if you select the Gemini provider. Get one at
# https://aistudio.google.com/apikey. Routed through Gemini's
# OpenAI-compatible endpoint (see SYSTEM_ONE_MODELS.md) -- chat/extraction
# only here; Gemini does have a working embeddings endpoint
# (gemini-embedding-2) but it is deliberately not wired up (see
# config.py's EMBEDDING_CAPABLE_PROVIDERS comment) -- embeddings stay on
# local Ollama unless that's a separate, explicit decision later.
GEMINI_API_KEY=

# -----------------------------------------------------------------------
# System One decision models -- a switchable alternative to the
# traditional LLM-call-based decision at every judgment point in the
# pipeline (branch selection, relevance gate, semantic dedup, sample
# quality scoring). See SYSTEM_ONE_MODELS.md before setting any of these.
# Traditional (the vars above) stays the default and keeps working exactly
# as today when USE_SYSTEM_ONE is left false/unset.
# -----------------------------------------------------------------------

# false (default) or true. true routes every decision point through
# SYSTEM_ONE_PROVIDER instead of the traditional method -- a single global
# switch, not per-decision-point. Validated at startup (config.py::
# validate_system_one_config): true with a missing/invalid provider, or a
# selected provider missing its key/package, fails immediately with a
# clear message rather than on the first decision made.
USE_SYSTEM_ONE=false

# "jev" or "laya". Only read when USE_SYSTEM_ONE=true.
SYSTEM_ONE_PROVIDER=

# Only needed if SYSTEM_ONE_PROVIDER=jev. Get one at
# https://console.typesafe.ai/. Hosted, pay-per-input-token ($0.042/1M
# input, output free) -- see SYSTEM_ONE_MODELS.md for the full API shape.
TYPESAFE_API_KEY=

# laya needs no key (open-weights, runs locally) but does need the `laya`
# package installed (`pip install laya` / `uv add laya`) -- NOT a current
# dependency of this project. Read SYSTEM_ONE_MODELS.md before installing:
# it pulls in torch>=2.14/transformers>=5, which may conflict with this
# project's numpy<2 pin (see CLAUDE.md's uv workflow section). Ask before
# installing, per CLAUDE.md's working conventions.
