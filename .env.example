# Copy this file to .env and fill in real values. .env is gitignored.

# Only needed if you select the OpenAI provider.
OPENAI_API_KEY=

# Only needed if you select the NVIDIA NIM provider.
# Get one at https://build.nvidia.com/ (free tier).
NVIDIA_API_KEY=

# Ollama (local): no key needed, config.py hardcodes localhost:11434.
